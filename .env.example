# video-hls configuration
#
#   cp .env.example .env    then edit as needed.
#
# Every value uses ${VAR:-default} form, so anything already exported in
# your shell wins over this file. Precedence:
#
#   environment  >  .env  >  built-in defaults
#
# That means you can keep a .env for the common case and still override
# per run:  VIDEO_CODEC=av1 ./run.sh
#
# Nothing here is required. Delete .env entirely and the defaults below
# still apply. Run ./run.sh --check to see what your machine supports.

# ------------------------------------------------------------------
# Directory layout
# ------------------------------------------------------------------
# $SCRIPT_DIR is the repo root, set before this file is sourced. Relative
# paths are resolved against it too, so ./run.sh behaves the same from any
# working directory. Use absolute paths to point at other volumes.
INPUT_ROOT="${INPUT_ROOT:-$SCRIPT_DIR/video}"          # drop sources here (recursive)
HLS_ROOT="${HLS_ROOT:-$SCRIPT_DIR/hls}"                # published packages; serve this
WORK_ROOT="${WORK_ROOT:-$SCRIPT_DIR/video-work}"       # scratch tree; safe to delete
PROCESSED_ROOT="${PROCESSED_ROOT:-$SCRIPT_DIR/video-done}"  # sources moved here on success

# Derived from WORK_ROOT; override only if you want them elsewhere.
ENCODED_ROOT="${ENCODED_ROOT:-$WORK_ROOT/encoded}"
STATE_ROOT="${STATE_ROOT:-$WORK_ROOT/state}"
LOG_ROOT="${LOG_ROOT:-$WORK_ROOT/logs}"

# ------------------------------------------------------------------
# Codecs
# ------------------------------------------------------------------
# h264 = plays everywhere, biggest files.
# hevc = ~40% smaller than h264; not supported by Chrome/Firefox on the open web.
# av1  = smallest; needs a modern player, slowest to encode in software.
VIDEO_CODEC="${VIDEO_CODEC:-h264}"            # h264 | hevc | av1

# aac  = universal. opus = better quality per bit, forces fMP4 segments.
AUDIO_CODEC="${AUDIO_CODEC:-aac}"             # aac | opus

# auto probes for a working GPU encoder and falls back to software.
# Set explicitly to force one, or 'none' to require CPU encoding.
HWACCEL="${HWACCEL:-auto}"                    # auto | nvenc | qsv | vaapi | videotoolbox | none

# Bypass VIDEO_CODEC/HWACCEL entirely with a literal ffmpeg encoder name
# (libx264, h264_nvenc, hevc_vaapi, libsvtav1, ...). Leave empty for auto.
VIDEO_ENCODER="${VIDEO_ENCODER:-}"

# Render node used by the vaapi encoders.
VAAPI_DEVICE="${VAAPI_DEVICE:-/dev/dri/renderD128}"

# ------------------------------------------------------------------
# Quality
# ------------------------------------------------------------------
# One knob, interpreted per encoder family. Lower = better quality,
# bigger files, in every case.
#   nvenc   -> -cq            sane range 19-32, default 28
#   qsv     -> -global_quality
#   vaapi   -> -qp
#   libx264 -> -crf           18 visually lossless, 23 default, 28 small
#   libx265 -> -crf           ~28 ≈ x264 crf 23
#   libsvtav1 / libaom -> -crf  ~30 ≈ x264 crf 23
QUALITY="${QUALITY:-28}"

# Speed/efficiency presets, per encoder family.
NVENC_PRESET="${NVENC_PRESET:-p6}"            # p1 fastest .. p7 best
X264_PRESET="${X264_PRESET:-medium}"          # ultrafast .. veryslow (libx264/libx265)
SVTAV1_PRESET="${SVTAV1_PRESET:-8}"           # 0 slowest/best .. 13 fastest
AOM_CPU_USED="${AOM_CPU_USED:-6}"             # libaom-av1: 0 slowest .. 8 fastest
QSV_PRESET="${QSV_PRESET:-medium}"

# ------------------------------------------------------------------
# HLS packaging
# ------------------------------------------------------------------
# Segment length in seconds. Also sets the keyframe interval
# (fps x HLS_TIME), which is what keeps every rendition's segment
# boundaries identical so players can switch tiers without stutter.
# 2-4 = faster startup / more responsive switching. 6-10 = fewer files.
HLS_TIME="${HLS_TIME:-6}"

HLS_PLAYLIST_TYPE="${HLS_PLAYLIST_TYPE:-vod}" # vod | event

# mpegts works only for h264+aac. auto picks fmp4 whenever you use
# hevc, av1 or opus, because MPEG-TS cannot carry them.
HLS_SEGMENT_TYPE="${HLS_SEGMENT_TYPE:-auto}"  # auto | mpegts | fmp4

# ------------------------------------------------------------------
# Rendition ladder
# ------------------------------------------------------------------
# Tiers taller than the source are always skipped - the pipeline never
# upscales. These two bounds trim the ladder further.
MAX_RESOLUTION_HEIGHT="${MAX_RESOLUTION_HEIGHT:-1080}"
MIN_RESOLUTION_HEIGHT="${MIN_RESOLUTION_HEIGHT:-360}"

# One row per tier, driving both the encode and the master playlist:
#   label  height  width  video_bitrate  maxrate  bufsize  audio_bitrate
# Uncomment to customise. Columns are whitespace-separated; blank lines
# and # comments are ignored.
#
# LADDER="${LADDER:-$(cat <<'EOF'
# 240p   240  426   400k   600k   900k   64k
# 360p   360  640   800k  1200k  1800k   96k
# 480p   480  854  1400k  2100k  3000k  128k
# 720p   720 1280  2800k  4200k  6000k  128k
# 1080p 1080 1920  5000k  7500k 10000k  192k
# 1440p 1440 2560  9000k 13500k 18000k  192k
# 2160p 2160 3840 16000k 24000k 32000k  256k
# EOF
# )}"

# ------------------------------------------------------------------
# Concurrency
# ------------------------------------------------------------------
# Concurrent encoder sessions = PARALLEL_VIDEOS x PARALLEL_RENDITIONS.
# Consumer NVIDIA cards historically cap simultaneous NVENC sessions, so
# raising both multiplies fast. For software encoding, prefer raising
# PARALLEL_VIDEOS=1 and letting libx264 use all cores itself.
PARALLEL_VIDEOS="${PARALLEL_VIDEOS:-1}"
PARALLEL_RENDITIONS="${PARALLEL_RENDITIONS:-3}"

# ------------------------------------------------------------------
# File handling
# ------------------------------------------------------------------
VIDEO_EXTENSIONS_REGEX="${VIDEO_EXTENSIONS_REGEX:-.*\.(mp4|mov|mkv|avi|webm|m4v|mpg|mpeg|ts|m2ts|flv|wmv)$}"

SKIP_EXISTING="${SKIP_EXISTING:-true}"        # reuse renditions already encoded
ARCHIVE_SOURCE="${ARCHIVE_SOURCE:-true}"      # false = leave sources in INPUT_ROOT
KEEP_RENDITIONS="${KEEP_RENDITIONS:-true}"    # false = delete intermediate MP4s after packaging

FFMPEG_LOGLEVEL="${FFMPEG_LOGLEVEL:-error}"   # quiet|error|warning|info|verbose|debug
